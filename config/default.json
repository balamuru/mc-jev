{
  "server": {
    "host": "localhost",
    "port": 25565,
    "version": false
  },
  "gateway": {
    "maxCallsPerMinute": 60,
    "dailyBudgetUsd": 1.0
  },
  "debug": {
    "snapshotIntervalMs": 1000
  },
  "defaults": {
    "perception": {
      "radiusBlocks": 24,
      "maxEntities": 8,
      "fovDegrees": 360,
      "requireLineOfSight": false
