    "jev": {
      "model": "jev-latest",
      "timeoutMs": 800,
      "maxRetries": 0,
      "thresholds": {
        "act": 0.7,
        "cautious": 0.5
      }
    }
  },
  "bots": [
    {
      "username": "JevBot",
      "role": "fighter"
    }
  ]
